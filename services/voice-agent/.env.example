# ─── Node API ────────────────────────────────────────────────────────────────
# Local dev: http://localhost:4174
NODE_API_BASE_URL=http://localhost:4174

# Must match PIPECAT_CONNECT_SECRET in the root .env. Never expose in VITE_* vars.
PIPECAT_CONNECT_SECRET=dev-pipecat-secret

# ─── Transport ────────────────────────────────────────────────────────────────
# websocket — local dev and Railway websocket mode (default)
# daily     — requires PIPECAT_DAILY_API_KEY + PIPECAT_DAILY_DOMAIN
VOICE_TRANSPORT=websocket
PIPECAT_ROOM_PROVIDER=daily
PIPECAT_DAILY_API_KEY=
PIPECAT_DAILY_DOMAIN=

# ─── STT ──────────────────────────────────────────────────────────────────────
# Speech-to-text runs entirely in the student's browser via the Web Speech API.
# The browser sends transcript text over the WebSocket — no server-side STT,
# no GPU, and no per-minute transcription cost.

# ─── LLM — Groq ───────────────────────────────────────────────────────────────
# Groq is OpenAI-compatible, pay-as-you-go, no fixed monthly fee.
# Leave GROQ_API_KEY blank to use the built-in fallback question generator.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TEMPERATURE=0.4
GROQ_MAX_TOKENS=700

# ─── TTS ──────────────────────────────────────────────────────────────────────
# Python emits assistant_text events only. Browser Kokoro speaks the text.
# No server-side audio synthesis. $0 cost.
TTS_PROVIDER=kokoro_browser

# ─── Service port ─────────────────────────────────────────────────────────────
# Railway injects $PORT automatically. Keep 7860 for local dev.
PORT=7860
