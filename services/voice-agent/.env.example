# Node API
# Local dev: http://localhost:4174
# Railway production: https://pathwisse-mockinterview-production-e582.up.railway.app
NODE_API_BASE_URL=http://localhost:4174

# Must match PIPECAT_CONNECT_SECRET on the Node/React service.
# Use a strong random secret in production. Never expose in VITE_* vars.
PIPECAT_CONNECT_SECRET=dev-pipecat-secret

# Transport — websocket for local dev and Railway websocket mode
# Set VOICE_TRANSPORT=daily only when using Daily.co rooms
VOICE_TRANSPORT=websocket

# Daily (only required when VOICE_TRANSPORT=daily)
PIPECAT_ROOM_PROVIDER=daily
PIPECAT_DAILY_API_KEY=
PIPECAT_DAILY_DOMAIN=

# STT — Python voice-agent owns STT through Pipecat pipeline
# whisper: local/Railway Whisper model (no external key needed)
# openai_realtime: requires OPENAI_API_KEY
STT_PROVIDER=whisper
WHISPER_MODEL=base
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-transcribe

# LLM — Mistral for live interview orchestration (server-side only)
# Never put MISTRAL_API_KEY in a VITE_* variable
LLM_PROVIDER=mistral
MISTRAL_API_KEY=
MISTRAL_LLM_MODEL=mistral-small-latest
MISTRAL_TEMPERATURE=0.4
MISTRAL_MAX_TOKENS=700

# TTS — kokoro_browser means Python emits assistant_text events only.
# Browser Kokoro speaks the text. Python does not perform server-side audio playback.
TTS_PROVIDER=kokoro_browser

# Service port — Railway injects $PORT automatically
PORT=7860
