# ─── Node API ────────────────────────────────────────────────────────────────
MOCK_INTERVIEW_PUBLIC_URL=http://localhost:5174
MOCK_INTERVIEW_SERVICE_PORT=4174
MOCK_INTERVIEW_SERVICE_SECRET=dev-secret
MOCK_INTERVIEW_CALLBACK_SECRET=dev-callback-secret
SESSION_TOKEN_SECRET=replace-me

# ─── Storage ──────────────────────────────────────────────────────────────────
# "file"     → local JSON file, no external DB needed (default for local dev)
# "supabase" → Supabase Postgres via SUPABASE_DATABASE_URL (use in production)
STORAGE_BACKEND=file
MOCK_INTERVIEW_STORE_PATH=.data/mock-interview-store.json

# Supabase (required when STORAGE_BACKEND=supabase)
# SUPABASE_URL and SUPABASE_SERVICE_KEY are your project's API credentials.
# SUPABASE_DATABASE_URL is the Transaction Pooler URL from the Supabase dashboard
# (Database > Connection string > Transaction mode).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_DATABASE_URL=

# Legacy direct Postgres (ignored when STORAGE_BACKEND is set explicitly)
DATABASE_URL=

# ─── React / Vite public vars ─────────────────────────────────────────────────
VITE_MOCK_INTERVIEW_API_URL=http://localhost:4174
VITE_VOICE_AGENT_PROVIDER=pipecat
VITE_VOICE_TRANSPORT=websocket
VITE_TTS_PROVIDER=kokoro

# Kokoro browser TTS (Apache-2.0, runs entirely in the browser — $0 cost)
VITE_KOKORO_MODEL_ID=onnx-community/Kokoro-82M-v1.0-ONNX
VITE_KOKORO_DTYPE=q8
VITE_KOKORO_DEVICE=wasm
VITE_KOKORO_VOICE=af_heart

# ─── Voice transport ──────────────────────────────────────────────────────────
VOICE_AGENT_PROVIDER=pipecat
VOICE_TRANSPORT=websocket

# ─── Pipecat service ──────────────────────────────────────────────────────────
PIPECAT_SERVICE_URL=http://localhost:7860
PIPECAT_CONNECT_SECRET=dev-pipecat-secret

# Daily transport (only needed when VOICE_TRANSPORT=daily)
PIPECAT_ROOM_PROVIDER=daily
PIPECAT_DAILY_API_KEY=
PIPECAT_DAILY_DOMAIN=

# ─── LLM — Groq ───────────────────────────────────────────────────────────────
# Groq is OpenAI-compatible, pay-as-you-go, no fixed monthly fee.
# Set LLM_PROVIDER=groq and supply GROQ_API_KEY to enable AI brief generation
# and interview report scoring. Leave blank to use the heuristic fallback scorer.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TEMPERATURE=0.3
GROQ_MAX_TOKENS=1200
GROQ_TIMEOUT_MS=15000
GROQ_RETRY_COUNT=1
