# Shared security
PLATFORM_ENV=local
JWT_SECRET=replace-with-32-byte-secret
HMAC_SHARED_SECRET=replace-with-career-engine-voice-agent-shared-secret
PUBLIC_INTERVIEW_BASE_URL=http://localhost:5174

# Career Engine
CAREER_ENGINE_PORT=4010
CAREER_ENGINE_DATABASE_URL=postgresql://postgres:postgres@localhost:5440/lumina_mock_interview
CAREER_ENGINE_REDIS_URL=redis://localhost:6384/0
CAREER_ENGINE_OBJECT_STORE=local
CAREER_ENGINE_STORE_PATH=.data/career-engine-store.json

# Voice Agent
VOICE_AGENT_PORT=8020
VOICE_AGENT_BASE_URL=http://localhost:8020
VITE_VOICE_AGENT_URL=http://localhost:8020
VOICE_SESSION_TTL_SECONDS=3600
VOICE_REDIS_URL=redis://localhost:6384/1
VOICE_STATE_TTL_SECONDS=7200
VOICE_TRANSPORT=websocket

# Realtime providers: Whisper STT -> Mistral LLM -> Kokoro TTS
# Put your real key only in local .env / deployment secrets. Do not commit it.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
WHISPER_MODEL=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=default
KOKORO_VOICE=af_heart

# LMS integration
LUMINA_GATEWAY_URL=http://localhost:8080
CAREER_OPS_CALLBACK_BASE_URL=http://localhost:4010

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
