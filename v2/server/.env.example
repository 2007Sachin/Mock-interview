# --- Required ---
# Get a free key at https://console.groq.com -> API Keys
GROQ_API_KEY=

# --- Defaults are fine for local development ---
# Groq chat model used for the interview brief and the report
GROQ_MODEL=llama-3.3-70b-versatile
# Groq Whisper model used for speech-to-text
GROQ_WHISPER_MODEL=whisper-large-v3
# Port the backend listens on
PORT=3001

# Storage backend: "file" (local JSON files in ./data) or "supabase"
STORAGE_BACKEND=file
# Only needed when STORAGE_BACKEND=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
